{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OXY7O/demo-app-laravel/compatibility/php-laravel.schema.json",
  "title": "PHP Laravel compatibility catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "profileKey", "asOf", "canonical", "runtimes", "matrixExpansion"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0"},
    "profileKey": {"const": "php-laravel"},
    "asOf": {"type": "string", "format": "date"},
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["laravel", "php", "executionMode"],
      "properties": {
        "laravel": {"type": "string", "pattern": "^[0-9]+$"},
        "php": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "executionMode": {"const": "canonical-artifact"}
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["php", "lifecycle", "executionMode", "blocking", "frameworkMajors"],
        "properties": {
          "php": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "lifecycle": {"enum": ["active", "security-only", "preview", "legacy-eol"]},
          "executionMode": {"enum": ["canonical-artifact", "compatibility-only", "exception-only"]},
          "blocking": {"type": "boolean"},
          "frameworkMajors": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "matrixExpansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requiresWorkflowCapability"],
      "properties": {
        "status": {"enum": ["planned", "enabled"]},
        "requiresWorkflowCapability": {"const": "compatibility-only-without-artifact"}
      }
    }
  }
}
